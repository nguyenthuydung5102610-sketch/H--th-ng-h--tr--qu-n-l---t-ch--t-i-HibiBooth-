PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://hibi_user:hibi_local_password@localhost:5432/hibi_booth
JWT_SECRET=replace-this-with-a-long-random-secret-before-deployment
JWT_EXPIRES_IN=8h
# Chỉ bật để thử luồng thanh toán giả lập trên máy local.
ENABLE_DEMO_PAYMENT=true

# payOS thật CHƯA KÍCH HOẠT. KHÔNG điền thông tin thật vào bản demo rồi đăng công khai.
# PAYOS_CLIENT_ID=
# PAYOS_API_KEY=
# PAYOS_CHECKSUM_KEY=

# Tin nhắn nhắc lịch (mặc định TẮT, không có SMS thật khi chưa cấu hình).
SMS_PROVIDER=disabled
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=

# payOS - chỉ điền trong server/.env trên máy, không commit
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# URL public của frontend dùng cho returnUrl/cancelUrl
PUBLIC_BASE_URL=http://localhost:5173

# === EMAIL + GOOGLE CALENDAR ===
# Khi chưa có API key, hệ thống chỉ lưu lịch nhắc vào DB và KHÔNG gửi email thật.
EMAIL_PROVIDER=disabled
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxxxx
# EMAIL_FROM=HIBI BOOTH <booking@your-verified-domain.example>
# Google Calendar dùng URL sự kiện; không cần khóa API hay OAuth.
