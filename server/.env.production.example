# DUNG TAI RENDER ENVIRONMENT -- KHONG COMMIT GIÁ TRỊ THẬT VÀO GIT
NODE_ENV=production
PORT=4000
CLIENT_ORIGIN=https://your-hibi.vercel.app
PUBLIC_BASE_URL=https://your-hibi.vercel.app
DATABASE_URL=postgresql://user:password@your-neon-host/database?sslmode=require
JWT_SECRET=replace-with-a-random-secret-of-32-or-more-characters
JWT_EXPIRES_IN=2h
ENABLE_DEMO_PAYMENT=false
ENABLE_PUBLIC_BOOKINGS=false
# Chỉ bật ENABLE_PUBLIC_BOOKINGS=true khi đủ payOS, email và kiểm thử xong.
# PAYOS_CLIENT_ID=
# PAYOS_API_KEY=
# PAYOS_CHECKSUM_KEY=
EMAIL_PROVIDER=disabled
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# EMAIL_FROM=HIBI BOOTH <booking@your-verified-domain.com>
# OWNER_EMAIL=
# OWNER_PASSWORD=
# OWNER_NAME=
